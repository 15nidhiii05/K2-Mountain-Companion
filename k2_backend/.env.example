# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQLite works out of the box. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/k2
DATABASE_URL=sqlite:///./k2.db
ACCESS_TOKEN_MINUTES=10080
# Origins allowed for the future React dashboard, comma separated
CORS_ORIGINS=
# SMS (Twilio). Leave blank and SOS will honestly report "not_configured".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=